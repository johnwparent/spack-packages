diff --git a/CMakeLists.txt b/CMakeLists.txt
index 497cf240..20d96d8c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -30,8 +30,11 @@ IF(NOT SCR_USE_EXTERNAL_RANKSTR)
     INCLUDE_DIRECTORIES(${CMAKE_SOURCE_DIR}/src/rankstr)
 ENDIF()
 
+IF(NOT SCR_USE_EXTERNAL_SPATH)
+    INCLUDE_DIRECTORIES(${CMAKE_SOURCE_DIR}/src/spath)
+ENDIF()
+
 INCLUDE_DIRECTORIES(
-    ${CMAKE_SOURCE_DIR}/src/spath
     ${CMAKE_SOURCE_DIR}/src/axl
     ${CMAKE_SOURCE_DIR}/src/shuffile
     ${CMAKE_SOURCE_DIR}/src/redset
diff --git a/cmake/SCR_DEPENDENCIES.cmake b/cmake/SCR_DEPENDENCIES.cmake
index 47d1c52a..af9f6578 100644
--- a/cmake/SCR_DEPENDENCIES.cmake
+++ b/cmake/SCR_DEPENDENCIES.cmake
@@ -50,6 +50,21 @@ IF(SCR_USE_EXTERNAL_RANKSTR)
     LIST(APPEND SCR_EXTERNAL_STATIC_LIBS rankstr::rankstr-static)
 ENDIF(SCR_USE_EXTERNAL_RANKSTR)
 
+## SPATH
+IF(SCR_USE_EXTERNAL_SPATH)
+    FIND_PACKAGE(spath REQUIRED)
+    GET_TARGET_PROPERTY(SPATH_INCLUDE_DIRS spath::spath-static INTERFACE_INCLUDE_DIRECTORIES)
+    INCLUDE_DIRECTORIES(${SPATH_INCLUDE_DIRS})
+    IF(BUILD_SHARED_LIBS AND TARGET spath::spath)
+        LIST(APPEND SCR_EXTERNAL_LIBS spath::spath)
+        LIST(APPEND SCR_EXTERNAL_SERIAL_LIBS spath::spath_base)
+    ELSE()
+        LIST(APPEND SCR_EXTERNAL_LIBS spath::spath-static)
+        LIST(APPEND SCR_EXTERNAL_SERIAL_LIBS spath::spath_base-static)
+    ENDIF()
+    LIST(APPEND SCR_EXTERNAL_STATIC_LIBS spath::spath-static)
+ENDIF(SCR_USE_EXTERNAL_SPATH)
+
 ## DataWarp
 IF(ENABLE_CRAY_DW)
     FIND_PACKAGE(DataWarp REQUIRED)

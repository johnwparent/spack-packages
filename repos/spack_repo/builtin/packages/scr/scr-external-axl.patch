diff --git a/CMakeLists.txt b/CMakeLists.txt
index 20d96d8c..6eabe7b9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -34,8 +34,11 @@ IF(NOT SCR_USE_EXTERNAL_SPATH)
     INCLUDE_DIRECTORIES(${CMAKE_SOURCE_DIR}/src/spath)
 ENDIF()
 
+IF(NOT SCR_USE_EXTERNAL_AXL)
+    INCLUDE_DIRECTORIES(${CMAKE_SOURCE_DIR}/src/axl)
+ENDIF()
+
 INCLUDE_DIRECTORIES(
-    ${CMAKE_SOURCE_DIR}/src/axl
     ${CMAKE_SOURCE_DIR}/src/shuffile
     ${CMAKE_SOURCE_DIR}/src/redset
     ${CMAKE_SOURCE_DIR}/src/er
diff --git a/cmake/SCR_DEPENDENCIES.cmake b/cmake/SCR_DEPENDENCIES.cmake
index af9f6578..f815a235 100644
--- a/cmake/SCR_DEPENDENCIES.cmake
+++ b/cmake/SCR_DEPENDENCIES.cmake
@@ -65,6 +65,21 @@ IF(SCR_USE_EXTERNAL_SPATH)
     LIST(APPEND SCR_EXTERNAL_STATIC_LIBS spath::spath-static)
 ENDIF(SCR_USE_EXTERNAL_SPATH)
 
+## AXL
+IF(SCR_USE_EXTERNAL_AXL)
+    FIND_PACKAGE(axl REQUIRED)
+    GET_TARGET_PROPERTY(AXL_INCLUDE_DIRS axl::axl_mpi-static INTERFACE_INCLUDE_DIRECTORIES)
+    INCLUDE_DIRECTORIES(${AXL_INCLUDE_DIRS})
+    IF(BUILD_SHARED_LIBS AND TARGET axl::axl_mpi)
+        LIST(APPEND SCR_EXTERNAL_LIBS axl::axl_mpi)
+        LIST(APPEND SCR_EXTERNAL_SERIAL_LIBS axl::axl)
+    ELSE()
+        LIST(APPEND SCR_EXTERNAL_LIBS axl::axl_mpi-static)
+        LIST(APPEND SCR_EXTERNAL_SERIAL_LIBS axl::axl-static)
+    ENDIF()
+    LIST(APPEND SCR_EXTERNAL_STATIC_LIBS axl::axl_mpi-static)
+ENDIF(SCR_USE_EXTERNAL_AXL)
+
 ## DataWarp
 IF(ENABLE_CRAY_DW)
     FIND_PACKAGE(DataWarp REQUIRED)

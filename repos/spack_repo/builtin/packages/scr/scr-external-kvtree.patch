index b6e8b916..7a13760b 100644
--- a/cmake/SCR_DEPENDENCIES.cmake
+++ b/cmake/SCR_DEPENDENCIES.cmake
@@ -22,6 +22,21 @@ IF(SCR_USE_EXTERNAL_DTCMP)
     LIST(APPEND SCR_EXTERNAL_STATIC_LIBS ${DTCMP_LIBRARIES})
 ENDIF(SCR_USE_EXTERNAL_DTCMP)
 
+## KVTREE
+IF(SCR_USE_EXTERNAL_KVTREE)
+    FIND_PACKAGE(kvtree REQUIRED)
+    GET_TARGET_PROPERTY(KVTREE_INCLUDE_DIRS kvtree::kvtree-static INTERFACE_INCLUDE_DIRECTORIES)
+    INCLUDE_DIRECTORIES(${KVTREE_INCLUDE_DIRS})
+    IF(BUILD_SHARED_LIBS AND TARGET kvtree::kvtree)
+        LIST(APPEND SCR_EXTERNAL_LIBS kvtree::kvtree)
+        LIST(APPEND SCR_EXTERNAL_SERIAL_LIBS kvtree::kvtree_base)
+    ELSE()
+        LIST(APPEND SCR_EXTERNAL_LIBS kvtree::kvtree-static)
+        LIST(APPEND SCR_EXTERNAL_SERIAL_LIBS kvtree::kvtree_base-static)
+    ENDIF()
+    LIST(APPEND SCR_EXTERNAL_STATIC_LIBS kvtree::kvtree-static)
+ENDIF(SCR_USE_EXTERNAL_KVTREE)
+
 ## DataWarp
 IF(ENABLE_CRAY_DW)
     FIND_PACKAGE(DataWarp REQUIRED)

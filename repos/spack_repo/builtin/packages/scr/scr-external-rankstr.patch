diff --git a/cmake/SCR_DEPENDENCIES.cmake b/cmake/SCR_DEPENDENCIES.cmake
index 7a13760b..47d1c52a 100644
--- a/cmake/SCR_DEPENDENCIES.cmake
+++ b/cmake/SCR_DEPENDENCIES.cmake
@@ -37,6 +37,19 @@ IF(SCR_USE_EXTERNAL_KVTREE)
     LIST(APPEND SCR_EXTERNAL_STATIC_LIBS kvtree::kvtree-static)
 ENDIF(SCR_USE_EXTERNAL_KVTREE)
 
+## RANKSTR
+IF(SCR_USE_EXTERNAL_RANKSTR)
+    FIND_PACKAGE(rankstr REQUIRED)
+    GET_TARGET_PROPERTY(RANKSTR_INCLUDE_DIRS rankstr::rankstr-static INTERFACE_INCLUDE_DIRECTORIES)
+    INCLUDE_DIRECTORIES(${RANKSTR_INCLUDE_DIRS})
+    IF(BUILD_SHARED_LIBS AND TARGET rankstr::rankstr)
+        LIST(APPEND SCR_EXTERNAL_LIBS rankstr::rankstr)
+    ELSE()
+        LIST(APPEND SCR_EXTERNAL_LIBS rankstr::rankstr-static)
+    ENDIF()
+    LIST(APPEND SCR_EXTERNAL_STATIC_LIBS rankstr::rankstr-static)
+ENDIF(SCR_USE_EXTERNAL_RANKSTR)
+
 ## DataWarp
 IF(ENABLE_CRAY_DW)
     FIND_PACKAGE(DataWarp REQUIRED)

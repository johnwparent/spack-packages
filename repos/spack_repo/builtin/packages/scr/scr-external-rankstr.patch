diff --git a/CMakeLists.txt b/CMakeLists.txt
index 95e0b7fe..497cf240 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -26,9 +26,12 @@ IF(NOT SCR_USE_EXTERNAL_KVTREE)
     INCLUDE_DIRECTORIES(${CMAKE_SOURCE_DIR}/src/kvtree)
 ENDIF()
 
+IF(NOT SCR_USE_EXTERNAL_RANKSTR)
+    INCLUDE_DIRECTORIES(${CMAKE_SOURCE_DIR}/src/rankstr)
+ENDIF()
+
 INCLUDE_DIRECTORIES(
     ${CMAKE_SOURCE_DIR}/src/spath
-    ${CMAKE_SOURCE_DIR}/src/rankstr

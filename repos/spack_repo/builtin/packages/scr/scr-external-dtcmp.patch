diff --git a/cmake/FindDTCMP.cmake b/cmake/FindDTCMP.cmake
new file mode 100644
index 00000000..4638d8fc
--- /dev/null
+++ b/cmake/FindDTCMP.cmake
@@ -0,0 +1,71 @@
+# - Try to find libdtcmp
+# Once done this will define
+#  DTCMP_FOUND - System has libdtcmp
+#  DTCMP_INCLUDE_DIRS - The libdtcmp include directories
+#  DTCMP_LIBRARIES - The libraries needed to use libdtcmp
+#
+# An installed dtcmp CMake package (dtcmpConfig.cmake) is preferred,
+# falling back to searching for the header and libraries directly.
+# Set WITH_DTCMP_PREFIX (and optionally WITH_LWGRP_PREFIX)
+# to search a specific install location first.
+
+INCLUDE(FindPackageHandleStandardArgs)
+
+# dtcmp's package finds lwgrp itself (needed for a static dtcmp)
+IF(WITH_LWGRP_PREFIX AND NOT LWGRP_ROOT)
+    SET(LWGRP_ROOT ${WITH_LWGRP_PREFIX})
+ENDIF()
+
+FIND_PACKAGE(dtcmp CONFIG QUIET HINTS ${WITH_DTCMP_PREFIX})
+IF(dtcmp_DIR AND NOT dtcmp_FOUND)
+    MESSAGE(FATAL_ERROR "Found ${dtcmp_DIR} but could not load it: ${dtcmp_NOT_FOUND_MESSAGE}")
+ENDIF()
+IF(TARGET dtcmp::dtcmp)
+    # the target carries MPI and, for a static dtcmp, lwgrp
+    GET_TARGET_PROPERTY(DTCMP_INCLUDE_DIRS dtcmp::dtcmp INTERFACE_INCLUDE_DIRECTORIES)
+    SET(DTCMP_LIBRARIES dtcmp::dtcmp)
+    FIND_PACKAGE_HANDLE_STANDARD_ARGS(DTCMP DEFAULT_MSG
+        DTCMP_LIBRARIES
+        DTCMP_INCLUDE_DIRS
+    )
+    RETURN()
+ENDIF()
+
+FIND_PATH(DTCMP_INCLUDE_DIRS
+    NAMES dtcmp.h
+    HINTS ${WITH_DTCMP_PREFIX}
+    PATH_SUFFIXES include
+)
+
+FIND_LIBRARY(DTCMP_LIBRARY
+    NAMES dtcmp
+    HINTS ${WITH_DTCMP_PREFIX}
+    PATH_SUFFIXES lib lib64
+)
+
+# dtcmp depends on lwgrp, which must be linked explicitly
+# when dtcmp is a static library
+FIND_LIBRARY(LWGRP_LIBRARY
+    NAMES lwgrp
+    HINTS ${WITH_LWGRP_PREFIX} ${WITH_DTCMP_PREFIX}
+    PATH_SUFFIXES lib lib64
+)
+
+FIND_PACKAGE_HANDLE_STANDARD_ARGS(DTCMP DEFAULT_MSG
+    DTCMP_LIBRARY
+    DTCMP_INCLUDE_DIRS
+)
+
+IF(DTCMP_FOUND)
+    SET(DTCMP_LIBRARIES ${DTCMP_LIBRARY})
+    IF(LWGRP_LIBRARY)
+        LIST(APPEND DTCMP_LIBRARIES ${LWGRP_LIBRARY})
+    ENDIF()
+ENDIF()
+
+# Hide these vars from ccmake GUI
+MARK_AS_ADVANCED(
+    DTCMP_LIBRARY
+    LWGRP_LIBRARY
+    DTCMP_INCLUDE_DIRS
+)

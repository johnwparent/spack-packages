diff --git a/cmake/SCR_DEPENDENCIES.cmake b/cmake/SCR_DEPENDENCIES.cmake
index 315f4eff..261d2973 100644
--- a/cmake/SCR_DEPENDENCIES.cmake
+++ b/cmake/SCR_DEPENDENCIES.cmake
@@ -95,6 +95,19 @@ IF(SCR_USE_EXTERNAL_REDSET)
     LIST(APPEND SCR_EXTERNAL_STATIC_LIBS redset::redset-static)
 ENDIF(SCR_USE_EXTERNAL_REDSET)
 
+## SHUFFILE
+IF(SCR_USE_EXTERNAL_SHUFFILE)
+    FIND_PACKAGE(shuffile REQUIRED)
+    GET_TARGET_PROPERTY(SHUFFILE_INCLUDE_DIRS shuffile::shuffile-static INTERFACE_INCLUDE_DIRECTORIES)
+    INCLUDE_DIRECTORIES(${SHUFFILE_INCLUDE_DIRS})
+    IF(BUILD_SHARED_LIBS AND TARGET shuffile::shuffile)
+        LIST(APPEND SCR_EXTERNAL_LIBS shuffile::shuffile)
+    ELSE()
+        LIST(APPEND SCR_EXTERNAL_LIBS shuffile::shuffile-static)
+    ENDIF()
+    LIST(APPEND SCR_EXTERNAL_STATIC_LIBS shuffile::shuffile-static)
+ENDIF(SCR_USE_EXTERNAL_SHUFFILE)
+
 ## DataWarp
 IF(ENABLE_CRAY_DW)
     FIND_PACKAGE(DataWarp REQUIRED)

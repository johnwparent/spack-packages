diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1c73948e..30c4e059 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -42,8 +42,11 @@ IF(NOT SCR_USE_EXTERNAL_REDSET)
     INCLUDE_DIRECTORIES(${CMAKE_SOURCE_DIR}/src/redset)
 ENDIF()
 
+IF(NOT SCR_USE_EXTERNAL_SHUFFILE)
+    INCLUDE_DIRECTORIES(${CMAKE_SOURCE_DIR}/src/shuffile)

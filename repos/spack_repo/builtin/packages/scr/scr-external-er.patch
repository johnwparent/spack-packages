diff --git a/cmake/SCR_DEPENDENCIES.cmake b/cmake/SCR_DEPENDENCIES.cmake
index 261d2973..1cb1208f 100644
--- a/cmake/SCR_DEPENDENCIES.cmake
+++ b/cmake/SCR_DEPENDENCIES.cmake
@@ -108,6 +108,19 @@ IF(SCR_USE_EXTERNAL_SHUFFILE)
     LIST(APPEND SCR_EXTERNAL_STATIC_LIBS shuffile::shuffile-static)
 ENDIF(SCR_USE_EXTERNAL_SHUFFILE)
 
+## ER
+IF(SCR_USE_EXTERNAL_ER)
+    FIND_PACKAGE(er REQUIRED)
+    GET_TARGET_PROPERTY(ER_INCLUDE_DIRS er::er-static INTERFACE_INCLUDE_DIRECTORIES)
+    INCLUDE_DIRECTORIES(${ER_INCLUDE_DIRS})
+    IF(BUILD_SHARED_LIBS AND TARGET er::er)
+        LIST(APPEND SCR_EXTERNAL_LIBS er::er)
+    ELSE()
+        LIST(APPEND SCR_EXTERNAL_LIBS er::er-static)
+    ENDIF()
+    LIST(APPEND SCR_EXTERNAL_STATIC_LIBS er::er-static)
+ENDIF(SCR_USE_EXTERNAL_ER)
+
 ## DataWarp
 IF(ENABLE_CRAY_DW)
     FIND_PACKAGE(DataWarp REQUIRED)

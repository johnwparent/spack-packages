diff --git a/cmake/SCR_DEPENDENCIES.cmake b/cmake/SCR_DEPENDENCIES.cmake
index f815a235..315f4eff 100644
--- a/cmake/SCR_DEPENDENCIES.cmake
+++ b/cmake/SCR_DEPENDENCIES.cmake
@@ -80,6 +80,21 @@ IF(SCR_USE_EXTERNAL_AXL)
     LIST(APPEND SCR_EXTERNAL_STATIC_LIBS axl::axl_mpi-static)
 ENDIF(SCR_USE_EXTERNAL_AXL)
 
+## REDSET
+IF(SCR_USE_EXTERNAL_REDSET)
+    FIND_PACKAGE(redset REQUIRED)
+    GET_TARGET_PROPERTY(REDSET_INCLUDE_DIRS redset::redset-static INTERFACE_INCLUDE_DIRECTORIES)
+    INCLUDE_DIRECTORIES(${REDSET_INCLUDE_DIRS})
+    IF(BUILD_SHARED_LIBS AND TARGET redset::redset)
+        LIST(APPEND SCR_EXTERNAL_LIBS redset::redset)
+        LIST(APPEND SCR_EXTERNAL_SERIAL_LIBS redset::redset_base)
+    ELSE()
+        LIST(APPEND SCR_EXTERNAL_LIBS redset::redset-static)
+        LIST(APPEND SCR_EXTERNAL_SERIAL_LIBS redset::redset_base-static)
+    ENDIF()
+    LIST(APPEND SCR_EXTERNAL_STATIC_LIBS redset::redset-static)
+ENDIF(SCR_USE_EXTERNAL_REDSET)
+
 ## DataWarp
 IF(ENABLE_CRAY_DW)
     FIND_PACKAGE(DataWarp REQUIRED)

diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..a7234d995d2335c09791396087ed8f65c11d1f1c
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,77 @@
+cmake_minimum_required(VERSION 3.30)
+
+project(DTCMP
+    VERSION 1.1.5
+    DESCRIPTION "Datatype Comparison Library"
+    HOMEPAGE_URL "https://github.com/hpc/dtcmp"
+    LANGUAGES C
+)
+
+include(GNUInstallDirs)
+include(CMakePackageConfigHelpers)
+
+list(PREPEND CMAKE_MODULE_PATH ${PROJECT_SOURCE_DIR}/cmake)
+
+option(BUILD_SHARED_LIBS "Build DTCMP as a shared library" ON)
+option(DTCMP_ENABLE_TESTS "Enable the build of DTCMP tests" OFF)
+
+# dtcmp.h exports global data without explict dllexport
+# no import lib would be generated, Windows must be static only
+if(WIN32 AND BUILD_SHARED_LIBS)
+    message(STATUS "DTCMP: shared libraries are not supported on Windows, building static")
+    set(BUILD_SHARED_LIBS OFF)
+endif()
+
+if(NOT DEFINED CMAKE_INSTALL_RPATH_USE_LINK_PATH)
+    set(CMAKE_INSTALL_RPATH_USE_LINK_PATH ON)
+endif()
+
+find_package(MPI REQUIRED COMPONENTS C)
+find_package(LWGRP REQUIRED)
+
+if(DTCMP_ENABLE_TESTS)
+    enable_testing()
+endif()
+
+add_subdirectory(src)
+
+set(DTCMP_INSTALL_CMAKEDIR ${CMAKE_INSTALL_LIBDIR}/cmake/dtcmp)
+
+install(TARGETS dtcmp
+    EXPORT dtcmp_targets
+    FILE_SET HEADERS DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+)
+install(EXPORT dtcmp_targets
+    FILE dtcmpTargets.cmake
+    NAMESPACE dtcmp::
+    DESTINATION ${DTCMP_INSTALL_CMAKEDIR}
+)
+configure_package_config_file(cmake/dtcmpConfig.cmake.in ${CMAKE_CURRENT_BINARY_DIR}/dtcmpConfig.cmake
+    INSTALL_DESTINATION ${DTCMP_INSTALL_CMAKEDIR}
+)
+write_basic_package_version_file(${CMAKE_CURRENT_BINARY_DIR}/dtcmpConfigVersion.cmake
+    VERSION ${PROJECT_VERSION}
+    COMPATIBILITY SameMajorVersion
+)
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/dtcmpConfig.cmake
+              ${CMAKE_CURRENT_BINARY_DIR}/dtcmpConfigVersion.cmake
+              cmake/FindLWGRP.cmake
+        DESTINATION ${DTCMP_INSTALL_CMAKEDIR}
+)
+
+# pkg-config file, using the same variables autoconf substitutes into libdtcmp.pc.in
+set(prefix ${CMAKE_INSTALL_PREFIX})
+set(exec_prefix "\${prefix}")
+set(libdir "\${exec_prefix}/${CMAKE_INSTALL_LIBDIR}")
+set(includedir "\${prefix}/${CMAKE_INSTALL_INCLUDEDIR}")
+set(PACKAGE_NAME ${PROJECT_DESCRIPTION})
+set(PACKAGE_VERSION ${PROJECT_VERSION})
+set(PACKAGE_URL ${PROJECT_HOMEPAGE_URL})
+configure_file(libdtcmp.pc.in ${CMAKE_CURRENT_BINARY_DIR}/libdtcmp.pc @ONLY)
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/libdtcmp.pc
+        DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig
+)
+
+install(FILES README.md LICENSE.TXT
+        DESTINATION ${CMAKE_INSTALL_DATADIR}/dtcmp
+)
diff --git a/cmake/FindLWGRP.cmake b/cmake/FindLWGRP.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..d394af256e261d4a74975071cf7c98935a4aa166
--- /dev/null
+++ b/cmake/FindLWGRP.cmake
@@ -0,0 +1,62 @@
+#[=======================================================================[.rst:
+FindLWGRP
+---------
+
+Find the LWGRP library (https://github.com/llnl/lwgrp).
+
+An installed LWGRP CMake package config (``lwgrpConfig.cmake``) is preferred,
+falling back to searching for the header and library directly.
+
+Set ``LWGRP_ROOT`` to the LWGRP install prefix if it is not in a default
+search location.
+
+Imported Targets
+^^^^^^^^^^^^^^^^
+
+``LWGRP::LWGRP``
+  The LWGRP library. lwgrp.h includes mpi.h, so this target links
+  ``MPI::MPI_C`` when that target exists.
+
+Result Variables
+^^^^^^^^^^^^^^^^
+
+``LWGRP_FOUND``
+``LWGRP_INCLUDE_DIR``
+  Only set when falling back to the header and library search.
+``LWGRP_LIBRARY``
+  Only set when falling back to the header and library search.
+#]=======================================================================]
+
+include(FindPackageHandleStandardArgs)
+
+find_package(LWGRP CONFIG QUIET NAMES lwgrp LWGRP)
+# wrap the package's target so dependents, including the dtcmp export, only
+# ever reference LWGRP::LWGRP regardless of how lwgrp was found
+if(LWGRP_FOUND AND NOT TARGET LWGRP::LWGRP AND TARGET lwgrp::lwgrp)
+    add_library(LWGRP::LWGRP INTERFACE IMPORTED)
+    target_link_libraries(LWGRP::LWGRP INTERFACE lwgrp::lwgrp)
+endif()
+if(TARGET LWGRP::LWGRP)
+    find_package_handle_standard_args(LWGRP CONFIG_MODE)
+    return()
+endif()
+
+find_path(LWGRP_INCLUDE_DIR NAMES lwgrp.h)
+find_library(LWGRP_LIBRARY NAMES lwgrp liblwgrp)
+
+find_package_handle_standard_args(LWGRP
+    REQUIRED_VARS LWGRP_LIBRARY LWGRP_INCLUDE_DIR
+)
+
+if(LWGRP_FOUND AND NOT TARGET LWGRP::LWGRP)
+    add_library(LWGRP::LWGRP UNKNOWN IMPORTED)
+    set_target_properties(LWGRP::LWGRP PROPERTIES
+        IMPORTED_LOCATION "${LWGRP_LIBRARY}"
+        INTERFACE_INCLUDE_DIRECTORIES "${LWGRP_INCLUDE_DIR}"
+    )
+    if(TARGET MPI::MPI_C)
+        set_property(TARGET LWGRP::LWGRP APPEND PROPERTY INTERFACE_LINK_LIBRARIES MPI::MPI_C)
+    endif()
+endif()
+
+mark_as_advanced(LWGRP_INCLUDE_DIR LWGRP_LIBRARY)
diff --git a/cmake/dtcmpConfig.cmake.in b/cmake/dtcmpConfig.cmake.in
new file mode 100644
index 0000000000000000000000000000000000000000..1b956b28120e12d42c61d3ffba2881fa0925c183
--- /dev/null
+++ b/cmake/dtcmpConfig.cmake.in
@@ -0,0 +1,18 @@
+@PACKAGE_INIT@
+
+include(CMakeFindDependencyMacro)
+
+find_dependency(MPI COMPONENTS C)
+
+# lwgrp is a private dependency, consumers only need it to link a static dtcmp
+if(NOT @BUILD_SHARED_LIBS@)
+    set(_dtcmp_module_path ${CMAKE_MODULE_PATH})
+    list(PREPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})
+    find_dependency(LWGRP)
+    set(CMAKE_MODULE_PATH ${_dtcmp_module_path})
+    unset(_dtcmp_module_path)
+endif()
+
+include(${CMAKE_CURRENT_LIST_DIR}/dtcmpTargets.cmake)
+
+check_required_components(dtcmp)
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..b859fee5275c4122d65cae3390a2b43accde5246
--- /dev/null
+++ b/src/CMakeLists.txt
@@ -0,0 +1,87 @@
+add_library(dtcmp)
+add_library(dtcmp::dtcmp ALIAS dtcmp)
+
+target_sources(dtcmp
+PRIVATE
+    dtcmp.c
+    dtcmp_util.c
+    dtcmp_ops.c
+    dtcmp_uniqify.c
+    dtcmp_search_binary.c
+    dtcmp_partitionz.c
+    dtcmp_partitionz_list.c
+    dtcmp_partition_local.c
+    dtcmp_merge_2way.c
+    dtcmp_merge_kway_heap.c
+    dtcmp_select_local_ends.c
+    dtcmp_select_local_randpartition.c
+    dtcmp_selectv_rand.c
+    dtcmp_selectv_medianofmedians.c
+    dtcmp_is_sorted.c
+    dtcmp_sort_local_insertionsort.c
+    dtcmp_sort_local_randquicksort.c
+    dtcmp_sort_local_mergesort.c
+    dtcmp_sort_local_qsort.c
+    dtcmp_sort_allgather.c
+    dtcmp_sort_bitonic.c
+    dtcmp_sort_samplesort.c
+    dtcmp_sortv_allgather.c
+    dtcmp_sortv_sortgather_scatter.c
+    dtcmp_sortv_cheng.c
+    dtcmp_sortz_samplesort.c
+    dtcmp_rankv_sort.c
+    dtcmp_seg_exscan.c
+PUBLIC
+FILE_SET HEADERS
+FILES
+    dtcmp.h
+PRIVATE
+FILE_SET private_header
+TYPE HEADERS
+FILES
+    dtcmp_internal.h
+    dtcmp_ops.h
+)
+# dtcmp.h includes mpi.h, lwgrp is only used internally
+target_link_libraries(dtcmp
+PUBLIC
+    MPI::MPI_C
+PRIVATE
+    LWGRP::LWGRP
+)
+
+if(DTCMP_ENABLE_TESTS)
+    add_executable(dtcmp_exe main.c)
+    target_link_libraries(dtcmp_exe PRIVATE dtcmp LWGRP::LWGRP)
+
+    add_executable(test_segscan test_segscan.c)
+    target_link_libraries(test_segscan PRIVATE dtcmp)
+
+    add_executable(dtcmp_tests tests.c)
+    target_link_libraries(dtcmp_tests PRIVATE dtcmp LWGRP::LWGRP)
+
+    set(DTCMP_TEST_NUM_PROCS "1;2;3;4" CACHE STRING "List of MPI rank counts used to run DTCMP tests")
+
+    foreach(num_procs IN LISTS DTCMP_TEST_NUM_PROCS)
+        if(num_procs GREATER MPIEXEC_MAX_NUMPROCS)
+            continue()
+        endif()
+
+        add_test(NAME test_segscan_np${num_procs}
+            COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG} ${num_procs}
+                    ${MPIEXEC_PREFLAGS} $<TARGET_FILE:test_segscan> ${MPIEXEC_POSTFLAGS}
+        )
+        # tests.c always exits 0
+        add_test(NAME dtcmp_tests_np${num_procs}
+            COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG} ${num_procs}
+                    ${MPIEXEC_PREFLAGS} $<TARGET_FILE:dtcmp_tests> ${MPIEXEC_POSTFLAGS}
+        )
+        set_tests_properties(test_segscan_np${num_procs} dtcmp_tests_np${num_procs} PROPERTIES
+            PROCESSORS ${num_procs}
+            LABELS mpi
+        )
+        set_tests_properties(dtcmp_tests_np${num_procs} PROPERTIES
+            FAIL_REGULAR_EXPRESSION "ERROR DETECTED;Invalid size"
+        )
+    endforeach()
+endif()

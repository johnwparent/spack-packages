diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
new file mode 100644
index 0000000..5db971c
--- /dev/null
+++ b/src/CMakeLists.txt
@@ -0,0 +1,39 @@
+add_library(lwgrp)
+add_library(lwgrp::lwgrp ALIAS lwgrp)
+
+target_sources(lwgrp
+PRIVATE
+  lwgrp.c
+  lwgrp_util.c
+  lwgrp_chain_ops.c
+  lwgrp_ring_ops.c
+  lwgrp_logchain_ops.c
+  lwgrp_logring_ops.c
+  lwgrp_comm.c
+  lwgrp_comm_split.c
+
+PUBLIC
+FILE_SET HEADERS
+  FILES
+    lwgrp.h
+
+PRIVATE
+FILE_SET private_headers
+  TYPE HEADERS
+  FILES
+    lwgrp_internal.h
+)
+if(USE_MPIANYSOURCE)
+  target_compile_definitions(lwgrp PUBLIC LWGRP_USE_ANYSOURCE)
+endif()
+
+# lwgrp_internal.h includes the autotools generated ../config/config.h, the only
+# setting it carries that is used (LWGRP_USE_ANYSOURCE) is defined above instead
+file(CONFIGURE OUTPUT ${PROJECT_BINARY_DIR}/config/config.h CONTENT "/* generated by CMake */\n")
+target_include_directories(lwgrp PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
+
+target_link_libraries(lwgrp PUBLIC MPI::MPI_C)
+
+if(LWGRP_ENABLE_TESTS)
+  add_subdirectory(test)
+endif()
diff --git a/src/test/CMakeLists.txt b/src/test/CMakeLists.txt
new file mode 100644
index 0000000..94fbf62
--- /dev/null
+++ b/src/test/CMakeLists.txt
@@ -0,0 +1,31 @@
+# MPI-driven test programs for lwgrp.
+#
+# These programs exercise the library's collectives and split operations.
+# They do not check results, so a test passes when every rank exits cleanly.
+
+set(LWGRP_TEST_NPROCS 4 CACHE STRING "Number of MPI ranks used to run the lwgrp tests")
+if(MPIEXEC_MAX_NUMPROCS AND LWGRP_TEST_NPROCS GREATER MPIEXEC_MAX_NUMPROCS)
+  message(WARNING
+    "LWGRP_TEST_NPROCS (${LWGRP_TEST_NPROCS}) is larger than MPIEXEC_MAX_NUMPROCS "
+    "(${MPIEXEC_MAX_NUMPROCS}); the MPI launcher may refuse to oversubscribe.")
+endif()
+
+set(LWGRP_TESTS
+  testcommops
+  testsplit
+  testsplit2
+)
+
+foreach(test IN LISTS LWGRP_TESTS)
+  add_executable(${test} ${test}.c)
+  target_link_libraries(${test} PRIVATE lwgrp)
+
+  add_test(NAME ${test}
+    COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG} ${LWGRP_TEST_NPROCS}
+            ${MPIEXEC_PREFLAGS} $<TARGET_FILE:${test}> ${MPIEXEC_POSTFLAGS}
+  )
+  set_tests_properties(${test} PROPERTIES
+    PROCESSORS ${LWGRP_TEST_NPROCS}
+    TIMEOUT 120
+  )
+endforeach()
